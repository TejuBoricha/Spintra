    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "eslint": "^10",
    "eslint-config-next": "16.2.10",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4",
    "typescript": "^7"
  }
