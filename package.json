{
  "name": "spintra",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:smoke": "npx playwright test",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/check-docs-drift.mjs",
    "verify": "npm run typecheck && npm run lint && npm run docs:check",
    "verify:migration": "node scripts/verify-migration.mjs",
    "ci": "npm run verify && npm audit --audit-level=high && npm run build && npm run test:smoke"
  },
