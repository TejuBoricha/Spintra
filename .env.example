# Supabase project credentials (Project Settings -> API in the Supabase dashboard).
# Both are required for the multiplayer /room feature (chat, participants,
# realtime sync) and for room creation to persist beyond the creating browser.
# Without them, the app still runs, but rooms fall back to a same-browser-tab
# demo mode (see src/lib/supabase/client.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry error monitoring (optional). Without NEXT_PUBLIC_SENTRY_DSN, Sentry
# never initializes (see sentry.*.config.ts) and the app runs exactly as
# before — this is not required to build or run.
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps for readable production stack traces;
# the build succeeds without these, just with unminified traces in Sentry.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
